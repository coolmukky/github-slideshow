rules_version = '2';
// ZTA Design Clinic — live app security rules.
// Model: everyone is signed in ANONYMOUSLY (Firebase Anonymous Auth), so there is
// no verified identity. Proctor status is a soft, PIN-gated claim (checked in the
// client, then the uid is added to the event's proctorUids). This is appropriate
// for a friendly internal workshop; for adversarial security, move proctor
// verification into a Cloud Function / custom claims (see DEPLOY.md → Hardening).
service cloud.firestore {
  match /databases/{database}/documents {

    match /events/{code} {
      allow read: if request.auth != null;

      // Creator makes the event and is its first proctor.
      allow create: if request.auth != null
                    && request.resource.data.proctorUids == [request.auth.uid];

      // Proctors may change anything (status, start/close, endsAt, title...).
      // Any signed-in user may add ONLY themselves to proctorUids (after the client
      // has checked the PIN) — this is the soft part; it changes no other field.
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.proctorUids
        || (
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proctorUids'])
             && request.auth.uid in request.resource.data.proctorUids
             && resource.data.proctorUids.toSet().difference(request.resource.data.proctorUids.toSet()).size() == 0
           )
      );

      allow delete: if request.auth != null && request.auth.uid in resource.data.proctorUids;

      // Teams: participants create and join teams while the event is open.
      match /teams/{teamId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null;
        allow delete: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/events/$(code)).data.proctorUids;
      }

      // Members: each participant writes only their own membership doc (keyed by uid).
      match /members/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // Scores: readable by all (leaderboard), writable only by proctors.
      match /scores/{teamId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
                     && request.auth.uid in get(/databases/$(database)/documents/events/$(code)).data.proctorUids;
      }
    }
  }
}
